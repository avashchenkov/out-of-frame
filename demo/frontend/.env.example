# Server settings. Use the same proxy secret as the demo backend.
OUT_OF_FRAME_DEMO_ORIGIN=https://demo.example.com
OUT_OF_FRAME_DEMO_BACKEND_URL=http://backend:2026
OUT_OF_FRAME_DEMO_PROXY_SECRET=
# Enable live submissions after completing the launch checklist.
OUT_OF_FRAME_DEMO_LIVE_ENABLED=false
# Web proxy limits for one Next.js process. Restart it after changing these.
OUT_OF_FRAME_DEMO_STREAMS=10
OUT_OF_FRAME_DEMO_STREAMS_PER_IDENTITY=2
OUT_OF_FRAME_DEMO_REQUESTS_PER_SECOND=20
OUT_OF_FRAME_DEMO_REQUEST_BURST=40
# Public contact for questions, feedback and data requests.
OUT_OF_FRAME_DEMO_CONTACT_EMAIL=outofframe.contact@proton.me
# Operator particulars for the Impressum and Privacy notice. Separate address lines with ";".
OUT_OF_FRAME_DEMO_OPERATOR_NAME=Artur Vashchenkov
OUT_OF_FRAME_DEMO_OPERATOR_ADDRESS=
# Name of the VPS hosting provider, shown as a recipient in the Privacy notice.
OUT_OF_FRAME_DEMO_HOSTING_PROVIDER=
