# Copy to demo/.env for Compose. Never commit the filled file.
# Public domain of the demo. Its DNS A record must point to the server before the first start.
OUT_OF_FRAME_DEMO_DOMAIN=demo.example.com
# Generate a random URL-safe password, for example with: openssl rand -hex 32
POSTGRES_PASSWORD=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# Agent overrides from the root .env.example can also be added here.
# Compose supplies DATABASE_URL and REDIS_URL using private service names.
RUN_MIGRATIONS_ON_STARTUP=false
REDIS_BROKER_ENABLED=true
# One run executes at a time; other admitted runs wait in Aegra's queue.
WORKER_COUNT=1
N_JOBS_PER_WORKER=1
CRON_ENABLED=false
LANGSMITH_TRACING=false
OTEL_TARGETS=
# Shared with the Web UI server only. Generate a random secret with at least 32 characters.
OUT_OF_FRAME_DEMO_PROXY_SECRET=
# Web UI settings, described in frontend/.env.example. Compose passes only these to it.
OUT_OF_FRAME_DEMO_LIVE_ENABLED=false
OUT_OF_FRAME_DEMO_CONTACT_EMAIL=outofframe.contact@proton.me
OUT_OF_FRAME_DEMO_OPERATOR_NAME=Artur Vashchenkov
OUT_OF_FRAME_DEMO_OPERATOR_ADDRESS=
OUT_OF_FRAME_DEMO_HOSTING_PROVIDER=
# Do not configure AEGRA_THREAD_TTL or checkpointer.ttl: cleanup invokes native pruning.
# Numeric defaults: demo/backend/config.py and docs/demo-architecture.md#demo-limits.
# OUT_OF_FRAME_DEMO_DAILY_CHATS=5
# OUT_OF_FRAME_DEMO_IDENTITY_CHATS=2
# OUT_OF_FRAME_DEMO_LIFETIME_DAYS=30
# OUT_OF_FRAME_DEMO_SUBMISSIONS=7
# OUT_OF_FRAME_DEMO_MESSAGE_CHARS=2000
# OUT_OF_FRAME_DEMO_CLEANUP_SECONDS=60
# OUT_OF_FRAME_DEMO_CANCEL_SECONDS=15

# Web proxy limits, before requests reach the backend. One Next.js process.
# OUT_OF_FRAME_DEMO_STREAMS=10
# OUT_OF_FRAME_DEMO_STREAMS_PER_IDENTITY=2
# OUT_OF_FRAME_DEMO_REQUESTS_PER_SECOND=20
# OUT_OF_FRAME_DEMO_REQUEST_BURST=40
