# Optional judge overrides. The root .env alone uses the defaults in evals/config.py.
# To override them, copy this file to evals/.env and uncomment the settings you need:
# uv run --env-file .env --env-file evals/.env python -m evals.run --part draft_finding --k 3
# Evaluation settings never belong in the agent service environment.
# OUT_OF_FRAME_JUDGE_MODEL=claude-haiku-5-5
# OUT_OF_FRAME_JUDGE_EFFORT=xhigh
# OUT_OF_FRAME_JUDGE_MAX_TOKENS=16000
