# Copy to .env and fill in your own keys. Never commit .env.

# Anthropic API: the agent's model, the prompt injection check's and the LLM judges'.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# The models, their efforts and their output tokens, if not the defaults in
# src/out_of_frame/config.py: the agent's, the prompt injection check's and the LLM judges'. An
# effort of "default" leaves it to the API.
# OUT_OF_FRAME_MODEL=claude-haiku-5-5
# OUT_OF_FRAME_EFFORT=high
# OUT_OF_FRAME_MAX_TOKENS=16000
# OUT_OF_FRAME_INJECTION_MODEL=claude-haiku-5-5
# OUT_OF_FRAME_INJECTION_EFFORT=default
# OUT_OF_FRAME_INJECTION_MAX_TOKENS=4096
# OUT_OF_FRAME_JUDGE_MODEL=claude-haiku-5-5
# OUT_OF_FRAME_JUDGE_EFFORT=xhigh
# OUT_OF_FRAME_JUDGE_MAX_TOKENS=16000

# Tavily: web search and page extract, the model's only tools.
# https://app.tavily.com
TAVILY_API_KEY=
# Web search settings, if not the defaults in src/out_of_frame/config.py.
# OUT_OF_FRAME_TOOL_CAP=3
# OUT_OF_FRAME_SEARCH_RESULTS=5
# OUT_OF_FRAME_PAGE_CHARS=40000
# OUT_OF_FRAME_WEB_ATTEMPTS=3
# Tries of one prompt injection check, if not the default in src/out_of_frame/config.py.
# OUT_OF_FRAME_CHECK_ATTEMPTS=2
# Drafts of one report, if not the default in src/out_of_frame/config.py.
# OUT_OF_FRAME_REPORT_ATTEMPTS=2

# Nominatim and Overpass, the free OpenStreetMap services, the Berlin B-Plan WFS and the
# Transitous journey planner, if not the defaults in src/out_of_frame/config.py. Set your own
# contact in the User-Agent if you run it often, and keep the version: Transitous asks for it.
# OUT_OF_FRAME_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# OUT_OF_FRAME_USER_AGENT=out-of-frame/0.1.0 (github.com/avashchenkov/out-of-frame)
# OUT_OF_FRAME_OVERPASS_URL=https://overpass-api.de/api/interpreter
# OUT_OF_FRAME_BPLAN_WFS_URL=https://gdi.berlin.de/services/wfs/bplan
# OUT_OF_FRAME_TRANSITOUS_URL=https://api.transitous.org/api/v5/plan
# OUT_OF_FRAME_SOURCE_ATTEMPTS=3

# LangSmith: traces of agent and eval runs. Optional; set LANGSMITH_TRACING=true to use it.
# https://smith.langchain.com/settings
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=out-of-frame
