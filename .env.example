# Copy to .env and fill in your own keys. Never commit .env.

# Anthropic API: the agent's model and the LLM judges.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# The model, if not the default in src/out_of_frame/config.py.
# OUT_OF_FRAME_MODEL=claude-haiku-5-5

# Tavily: web search and page extract, the model's only tools.
# https://app.tavily.com
TAVILY_API_KEY=
# Web search settings, if not the defaults in src/out_of_frame/config.py.
# OUT_OF_FRAME_TOOL_CAP=3
# OUT_OF_FRAME_SEARCH_RESULTS=5
# OUT_OF_FRAME_PAGE_CHARS=40000
# OUT_OF_FRAME_WEB_ATTEMPTS=3
# Tries of one prompt injection check, if not the default in src/out_of_frame/config.py.
# OUT_OF_FRAME_CHECK_ATTEMPTS=2

# Nominatim and Overpass, the free OpenStreetMap services, if not the defaults in
# src/out_of_frame/config.py. Set your own contact in the User-Agent if you run it often.
# OUT_OF_FRAME_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# OUT_OF_FRAME_USER_AGENT=out-of-frame (github.com/avashchenkov/out-of-frame)
# OUT_OF_FRAME_OVERPASS_URL=https://overpass-api.de/api/interpreter
# OUT_OF_FRAME_SOURCE_ATTEMPTS=3

# LangSmith: traces of agent and eval runs. Optional; set LANGSMITH_TRACING=true to use it.
# https://smith.langchain.com/settings
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=out-of-frame
